NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/rupakar
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000
# Include every browser frontend that calls the API. In production, use the
# HTTPS customer and seller deployment origins (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Seller deployment origin. It is added to the explicit credentialed CORS allow-list.
SELLER_FRONTEND_URL=http://localhost:3001
# Leave COOKIE_DOMAIN empty for host-only cookies. Set it only for a shared
# parent domain (for example .rupakar.example); it cannot bridge Vercel/Render.
COOKIE_DOMAIN=
# Use none for different-site HTTPS deployments; use lax for same-site subdomains.
COOKIE_SAMESITE=none
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=change-me
CONTACT_EMAIL=hello@example.com
SMS_PROVIDER=twilio
STORAGE_BUCKET=rupakar-dev
# Private Backblaze B2 S3-compatible document storage. Cloudinary remains for media.
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=rupakar-documents
S3_REGION=us-west-004
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
SHIPPING_ENABLED=false
SHIPPING_BASE_FEE=50
SHIPPING_EXTRA_ITEM_FEE=20
FREE_SHIPPING_THRESHOLD=500
WEST_BENGAL_SHIPPING_DISCOUNT=10
PAYMENT_MOCK_ENABLED=false
WORKER_ENABLED=false

