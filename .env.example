# ==============================================================================
# Rupakar - Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this template to .env in the backend root directory:
#      cp .env.example .env
# 2. Configure values according to your target deployment environment.
# 3. Keep real credentials and secrets strictly private; never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# Server port for the Express application
PORT=4000

# Canonical public backend API URL (used for webhooks and asset URLs)
BACKEND_URL=http://localhost:4000

# Customer storefront URL
FRONTEND_URL=http://localhost:3000

# Seller management portal URL
SELLER_FRONTEND_URL=http://localhost:3001

# Allowed origins for CORS (comma-separated; must use https:// in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookie domain (leave empty for localhost or cross-origin; use .domain.com for shared subdomains)
COOKIE_DOMAIN=

# Cookie SameSite attribute: lax (subdomains/same-site) | none (cross-origin HTTPS)
COOKIE_SAMESITE=lax

# Force-enable Swagger OpenAPI docs in production (always active in development at /api-docs)
ENABLE_SWAGGER=false

# Brand logo URL used in transaction receipts and system emails
RUPAKAR_LOGO_URL=http://localhost:4000/Rupakar-logo.jpeg


# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (replica set required for multi-document ACID transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/rupakar


# ------------------------------------------------------------------------------
# 3. Redis & Background Queue Configuration
# ------------------------------------------------------------------------------
# Redis connection URL (used for BullMQ job queues, caching, and rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# Redis integration toggle (set to true in production)
REDIS_ENABLED=false

# Worker process toggle (set to false to run the instance as a stateless HTTP server)
WORKER_ENABLED=false


# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing access tokens (minimum 32 random characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters

# Cryptographic secret for signing refresh tokens (minimum 32 random characters)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters

# Access token validity duration
ACCESS_TOKEN_EXPIRATION=15m

# Refresh token validity duration
REFRESH_TOKEN_EXPIRATION=7d

# Expiration window for unverified user registrations before cleanup
PENDING_REGISTRATION_TTL=24h


# ------------------------------------------------------------------------------
# 5. OAuth 2.0 (Google Authentication)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Authorized OAuth redirect callback URL
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback


# ------------------------------------------------------------------------------
# 6. Payment Processing (Razorpay & Razorpay Route)
# ------------------------------------------------------------------------------
# Razorpay Key ID (use rzp_test_... in development; rzp_live_... in production)
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook signature verification secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Enable automated marketplace transfers via Razorpay Route
RAZORPAY_ROUTE_ENABLED=false

# Platform merchant account number for Route settlement routing
RAZORPAY_ACCOUNT_NUMBER=

# Mock payment gateway toggle (permitted only in development)
PAYMENT_MOCK_ENABLED=false


# ------------------------------------------------------------------------------
# 7. Email Notification Services
# ------------------------------------------------------------------------------
# Active email provider: smtp | resend | brevo
EMAIL_PROVIDER=smtp

# SMTP host and credentials (used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=your_smtp_password

# Default sender email address
EMAIL_FROM=noreply@rupakar.com

# Public customer support contact email
CONTACT_EMAIL=hello@rupakar.com

# Resend API Key (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Brevo API Key (used when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=


# ------------------------------------------------------------------------------
# 8. SMS & OTP Verification Services
# ------------------------------------------------------------------------------
# Toggle SMS delivery (disabled by default to avoid unintended provider costs)
SMS_ENABLED=false

# Active SMS provider: msg91 | twilio | http
SMS_PROVIDER=msg91

# MSG91 integration settings
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_API_URL=https://control.msg91.com/api/v5/flow/

# Twilio integration settings (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Generic HTTP SMS gateway settings (used when SMS_PROVIDER=http)
SMS_API_URL=
SMS_API_KEY=


# ------------------------------------------------------------------------------
# 9. Media & Document Storage (Cloudinary & S3/B2)
# ------------------------------------------------------------------------------
# Active document storage provider: cloudinary | s3
STORAGE_PROVIDER=cloudinary

# Default storage bucket or directory namespace
STORAGE_BUCKET=rupakar-dev

# Cloudinary credentials (used for public product images and avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 / Backblaze B2 credentials (used for private seller documents and invoices)
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------------------
# 10. Shipping & Logistics (Delhivery / Mock)
# ------------------------------------------------------------------------------
# Enable dynamic shipping fee calculation
SHIPPING_ENABLED=false

# Base delivery fee (INR)
SHIPPING_BASE_FEE=50

# Surcharge per additional item (INR)
SHIPPING_EXTRA_ITEM_FEE=20

# Cart threshold for free delivery (INR)
FREE_SHIPPING_THRESHOLD=1500

# Regional discount for West Bengal destinations (INR)
WEST_BENGAL_SHIPPING_DISCOUNT=10

# Logistics operational mode: mock | delhivery | shiprocket
DELIVERY_MODE=mock

# Logistics provider implementation: mock | delhivery | shiprocket
DELIVERY_PROVIDER=mock

# Delhivery tracking and manifest API base URL
DELIVERY_API_URL=https://track.delhivery.com

# Delhivery API token
DELIVERY_API_TOKEN=

# Secret for verifying delivery tracking webhook signatures
DELIVERY_WEBHOOK_SECRET=your_delivery_webhook_secret

# Shiprocket logistics integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in
SHIPROCKET_WEBHOOK_TOKEN=


# ------------------------------------------------------------------------------
# 11. System Policies & Data Retention
# ------------------------------------------------------------------------------
# Number of days to retain read notifications before automated pruning
READ_NOTIFICATION_RETENTION_DAYS=15


# ------------------------------------------------------------------------------
# 12. Admin Bootstrap CLI (create-admin.js)
# ------------------------------------------------------------------------------
# Optional credentials for non-interactive administrative bootstrapping
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_UPDATE_PASSWORD=false
